{
  "name": "tangier",
  "version": "1.2.0",
  "type": "module",
  "private": true,
  "scripts": {
    "test": "vitest --reporter=verbose",
    "dev": "next dev --turbopack",
    "build": "SKIP_ENV_VALIDATION=1 next build && cp -r public .next/standalone/ && cp -r .next/static .next/standalone/.next/",
    "start": "next start",
    "lint": "eslint",
    "format": "prettier --write \"**/*.{ts,tsx}\"",
    "intl-check": "i18n-check --unused . --locales ./messages/ --source en-ID --format next-intl",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@base-ui/react": "^1.4.1",
    "@internationalized/date": "^3.12.1",
    "@node-escpos/core": "^0.6.0",
    "@node-escpos/usb-adapter": "^0.3.1",
    "@phosphor-icons/react": "^2.1.10",
    "@t3-oss/env-nextjs": "^0.13.11",
    "@tanstack/react-form": "^1.29.1",
    "@tanstack/react-form-nextjs": "^1.29.1",
    "better-auth": "^1.6.9",
    "chroma-js": "^3.2.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "date-fns": "^4.1.0",
    "drizzle-orm": "^0.45.2",
    "es-toolkit": "^1.46.1",
    "next": "16.1.7",
    "next-intl": "^4.12.0",
    "next-themes": "^0.4.6",
    "pg": "^8.20.0",
    "radix-ui": "^1.4.3",
    "react": "^19.2.4",
    "react-aria-components": "^1.17.0",
    "react-dom": "^19.2.4",
    "react-hotkeys-hook": "^5.3.2",
    "react-number-format": "^5.4.5",
    "shadcn": "^4.4.0",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.5.0",
    "tw-animate-css": "^1.4.0",
    "uuid": "^14.0.0",
    "valtio": "^2.3.1",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3",
    "@lingual/i18n-check": "^0.9.5",
    "@tailwindcss/postcss": "^4.2.1",
    "@types/chroma-js": "^3.1.2",
    "@types/node": "^25.5.0",
    "@types/pg": "^8.20.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "drizzle-kit": "^0.31.10",
    "eslint": "^9.39.4",
    "eslint-config-next": "16.1.7",
    "postcss": "^8",
    "prettier": "^3.8.3",
    "prettier-plugin-tailwindcss": "^0.7.2",
    "tailwindcss": "^4.2.1",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3",
    "vitest": "^4.1.7"
  }
